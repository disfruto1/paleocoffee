# Tarayicinin API'ye ulastigi adres (yayinda: https://api.alanadiniz.com)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Sunucu tarafinda (urun sayfalari) kullanilan adres. Docker'da ic ag adresi verilir. Bos ise yukaridaki kullanilir
API_URL=
# 1: online satis acik (urunler, sepet, odeme, uyelik, yonetim). Bos/0: yalnizca tanitim sitesi
NEXT_PUBLIC_SATIS_ACIK=1
# Sitenin kendi adresi: arama motorlari ve paylasim onizlemeleri icin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
