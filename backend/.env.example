DATABASE_URL=postgresql+psycopg2://kullanici:sifre@localhost/paleo_db
# Zorunlu. Uretmek icin: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=buraya-uzun-ve-gizli-bir-anahtar-yaz
ALGORITHM=HS256
# Yenileme (refresh) token'i henuz yok, bu yuzden 1 gun (1440 dk)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Web sitesinin adresi, virgulle birden fazla yazilabilir. Bos ise http://localhost:3000 kullanilir
ALLOWED_ORIGINS=
# Web sitesinin adresi. PayTR odemesinden sonra musteri buradaki /odeme/sonuc sayfasina doner
SITE_ADRESI=http://localhost:3000

# Teslimat ucretleri (TL). KARGO_UCRETI bos ise kargo kapali olur; 0 yazilirsa kargo ucretsizdir.
KARGO_UCRETI=
# Ayvalik ici adrese teslim. Bos ise ucretsiz
AYVALIK_TESLIMAT_UCRETI=
# Bu tutar ve uzerindeki siparislerde kargo ve Ayvalik ici teslimat ucretsiz. Bos ise sinir yok
UCRETSIZ_TESLIMAT_SINIRI=

# Sifre sifirlama e-postalari (SMTP veren her servisle calisir, ornegin Resend veya Brevo).
# SMTP_HOST bos ise e-posta gitmez ve kullanici sifre sifirlama kodu alamaz.
SMTP_HOST=
SMTP_PORT=587
SMTP_KULLANICI=
SMTP_SIFRE=
# Servisin onayladigi gonderen adres, ornegin: Paleo Coffee <merhaba@alanadiniz.com>
SMTP_GONDEREN=
# Yeni siparis bildirimlerinin gidecegi kafe e-postasi. Bos ise kafeye bildirim gitmez
SIPARIS_BILDIRIM_EPOSTASI=
# Yonetim panelinden yuklenen urun gorsellerinin klasoru
YUKLEME_KLASORU=yuklenen
# Sadece gelistirmede: 1 yapilirsa e-posta yerine kod konsola yazilir. Yayinda ACMAYIN.
EPOSTA_KONSOLA_YAZ=

# PayTR kart odemesi (Paleo Coffee'nin kendi magazasi). Degerler: Magaza Paneli > Destek & Kurulum > Entegrasyon Bilgileri.
# Bos ise kart odemesi kapali olur. Bu uc degeri repoya veya sohbete YAZMAYIN.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Backend'in internetten erisilen adresi, ornegin: https://api.alanadiniz.com
PAYTR_DONUS_ADRESI=
# Zorunlu, 0 veya 1. 1 iken para alinmaz AMA siparis "odendi" olur. Yayinda 0 olmali.
PAYTR_TEST_MODU=
# 1: tek cekim, 2-12: en fazla o kadar taksit, 0: PayTR'in izin verdigi en yuksek taksit
PAYTR_MAX_TAKSIT=1
# Sadece yerel denemede: PayTR dis IP ister, buraya kendi dis IP'nizi yazin
PAYTR_YEREL_IP=
# Siparis sonrasi musteriye gosterilen odeme bilgisi (havale/EFT). Bos birakilabilir.
ODEME_BILGISI=Havale/EFT ile odeme: TR00 0000 0000 0000 0000 0000 00 - Ad Soyad. Aciklamaya siparis numarasini yazin.
