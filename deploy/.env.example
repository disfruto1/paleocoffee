# Sunucuda bu dosyayi deploy/.env olarak kopyalayip doldurun. .env repoya GIRMEZ, sohbete de yazmayin.
# Degerlerde $ isareti kullanmayin (Docker Compose degisken sanar).

# Sitenin ve API'nin adresleri. Ikisinin de DNS kaydi sunucuya bakmali.
SITE_ALAN_ADI=paleocoffee.com.tr
API_ALAN_ADI=api.paleocoffee.com.tr

# Uretmek icin: openssl rand -hex 24
POSTGRES_PASSWORD=
# Zorunlu. Uretmek icin: openssl rand -hex 48 (yerel .env'dekini KULLANMAYIN)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Teslimat ucretleri (TL). KARGO_UCRETI bos ise kargo kapali olur.
KARGO_UCRETI=
AYVALIK_TESLIMAT_UCRETI=
UCRETSIZ_TESLIMAT_SINIRI=

# Sifre sifirlama e-postalari (Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_KULLANICI=resend
SMTP_SIFRE=
SMTP_GONDEREN="Paleo Coffee <merhaba@paleocoffee.com.tr>"
# Yeni siparislerin bildirilecegi kafe e-postasi
SIPARIS_BILDIRIM_EPOSTASI=
# Yayinda bos kalmali
EPOSTA_KONSOLA_YAZ=

# PayTR (Paleo Coffee'nin kendi magazasi). Ilk uc deger bos ise kart odemesi kapali olur.
# Donus ve bildirim adresleri alan adlarindan otomatik olusur (docker-compose.yml).
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 iken para alinmaz AMA siparis "odendi" olur. Gercek satisa baslarken 0 yapin.
PAYTR_TEST_MODU=1
PAYTR_MAX_TAKSIT=1
# Yayinda bos kalmali
PAYTR_YEREL_IP=

# Havale/EFT bilgisi: gercek IBAN'inizi yazin
ODEME_BILGISI=
